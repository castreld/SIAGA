<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background"
        tools:context=".Settings">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="#222325">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/backicons"
                android:contentDescription="Back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="#ECF0F1"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="95dp"
                android:background="@drawable/siaga" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SIAGA"
                android:textColor="@color/colorTxt"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="20dp"
            android:padding="5dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX GAS THRESHOLD"
                android:textColor="@color/colorTxt"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_minimalist"
                android:elevation="2dp"
                app:boxBackgroundMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/maxGasThresholdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Recommendation around 300 - 500"
                    android:gravity="top|start"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textColor="@color/colorTxt"
                    android:textColorHint="@color/colorTxtPlaceholder" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/maxGasThresholdOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Max Threshold : Value"
                android:textColor="@color/secColorTxt"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM NOTIFICATION"
                android:textColor="@color/colorTxt"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/card_minimalist"
                android:elevation="2dp"
                app:boxBackgroundMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/customNotificationInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Enter Custom Notification Message"
                    android:background="@null"
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:textColor="@color/colorTxt"
                    android:textColorHint="@color/colorTxtPlaceholder"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIBRATION"
                android:textColor="@color/colorTxt"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <Switch
                android:id="@+id/vibrationSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.25"
                android:scaleY="1.25"
                android:layout_margin="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product ID"
                    android:textColor="@color/colorTxt"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_minimalist"
                    android:elevation="2dp"
                    app:boxBackgroundMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/productIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Your Product ID"
                        android:gravity="top|start"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="@color/secColorTxtPlaceholder"
                        android:textColorHint="@color/secColorTxtPlaceholder" />

                </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/wifiSetButton"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@drawable/card_minimalist"
                android:layout_marginTop="24dp"
                android:text="WiFi SETTINGS"
                android:textColor="@color/secColorTxt"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:elevation="2dp"
                android:padding="12dp"/>

            <Button
                android:id="@+id/submitButton"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@drawable/card_minimalist"
                android:layout_marginTop="24dp"
                android:text="SAVE SETTINGS"
                android:textColor="@color/secColorTxt"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:elevation="2dp"
                android:padding="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>